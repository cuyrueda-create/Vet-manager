# Plantilla de variables de entorno del BACKEND (FastAPI)
# ------------------------------------------------------------------
# INSTRUCCIONES:
#   1. Copia este archivo a `backend/.env`:  cp backend/.env.example backend/.env
#   2. Reemplaza cada valor de ejemplo con uno real.
#   3. NUNCA subas el archivo `backend/.env` al repositorio.
#
# Nota: dentro de Docker Compose, docker-compose.yml inyecta estas mismas
# variables y tienen prioridad sobre este archivo. Este `.env` se usa
# cuando ejecutas el backend directamente en tu máquina (fuera de Docker).

# --- Conexión a MySQL ---
DB_HOST=localhost
DB_USER=vet_user
DB_PASSWORD=cambia_esta_clave_vet
DB_NAME=vet_manager
DB_PORT=3307

# --- Seguridad ---
# Clave para firmar los JWT. Genera una con: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambia_esta_clave_secreta_larga

# --- Correo transaccional (SMTP de Gmail) ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=tu_correo@gmail.com
EMAIL_PASSWORD=tu_app_password_de_gmail
