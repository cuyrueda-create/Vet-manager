# Plantilla de variables de entorno del proyecto Vet Manager
# ------------------------------------------------------------------
# INSTRUCCIONES:
#   1. Copia este archivo a `.env` en la raíz del proyecto:  cp .env.example .env
#   2. Reemplaza cada valor de ejemplo con uno real.
#   3. NUNCA subas el archivo `.env` al repositorio (está en .gitignore).
#
# Este archivo lo lee Docker Compose para inyectar variables en los
# contenedores (MySQL, backend y correo).

# --- Correo transaccional (SMTP de Gmail) ---
# Genera una "contraseña de aplicación" en: https://myaccount.google.com/apppasswords
EMAIL_USER=tu_cuenta@brevo.com
EMAIL_PASSWORD=tu_clave_smtp_de_brevo

# --- MySQL 8 ---
MYSQL_ROOT_PASSWORD=cambia_esta_clave_root
MYSQL_DATABASE=vet_manager
# Rol de la API: solo CRUD + EXECUTE (§7.3 del plan)
MYSQL_APP_USER=vet_app
MYSQL_PASSWORD=cambia_esta_clave_vet
# Rol con DDL para las migraciones del arranque (§7.3).
# Si MYSQL_OWNER_PASSWORD no está definida se reutiliza MYSQL_PASSWORD.
MYSQL_OWNER_USER=vet_owner
MYSQL_OWNER_PASSWORD=cambia_esta_clave_owner

# --- Backend FastAPI ---
# Clave para firmar los JWT. Genera una con: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambia_esta_clave_secreta_larga
# Clave maestra para crear la primera cuenta de administrador
ADMIN_CREATE_KEY=CAMBIA-ESTA-CLAVE

# Remitente verificado en Brevo
EMAIL_FROM=contacto@vetmanager.app
