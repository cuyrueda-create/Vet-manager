# Plantilla de variables de entorno del FRONTEND (Vite / React)
# ------------------------------------------------------------------
# INSTRUCCIONES:
#   1. Copia este archivo a `frontend/.env`:  cp frontend/.env.example frontend/.env
#   2. Reemplaza cada valor de ejemplo con uno real.
#   3. NUNCA subas el archivo `frontend/.env` al repositorio.
#
# Las variables de Vite deben empezar con VITE_ para estar disponibles
# en el navegador (no pongas secretos aquí: todo lo de VITE_ es público).

# URL base de la API. En desarrollo local: http://localhost:5000
# En despliegue con Caddy (proxy inverso): /
VITE_API_URL=http://localhost:5000

# --- Datos visibles de la interfaz ---
VITE_APP_NAME=Vet Manager
VITE_CONTACT_EMAIL=contacto@ejemplo.com
VITE_CONTACT_PHONE=3000000000
VITE_CONTACT_LOCATION=Ciudad, Colombia
