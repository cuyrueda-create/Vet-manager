# Variables de entorno de PRODUCCIÓN — plantilla
# ------------------------------------------------------------------
# INSTRUCCIONES:
#   1. Copia este archivo a `.env` en la raíz del release desplegado:
#        cp deploy/env.prod.example .env
#   2. Reemplaza cada valor de ejemplo con uno real.
#   3. Permisos obligatorios:  chmod 600 .env
#   4. NUNCA subas este archivo al repositorio (.env está en .gitignore).
#
# Genera valores con:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"   # SECRET_KEY

# --- Versión a desplegar (debe coincidir con la etiqueta de las imágenes) ---
APP_VERSION=1.0.0
APP_ENV=produccion

# --- Dominio (lo usa deploy/Caddyfile) ---
DOMINIO=ejemplo.com

# --- MySQL 8 ---
MYSQL_ROOT_PASSWORD=cambia_esta_clave_root
MYSQL_DATABASE=vet_manager
# Rol de la API: solo CRUD + EXECUTE (§7.3 del plan)
MYSQL_APP_USER=vet_app
MYSQL_PASSWORD=cambia_esta_clave_vet
# Rol con DDL para las migraciones del arranque (§7.3).
# Si MYSQL_OWNER_PASSWORD no está definida se reutiliza MYSQL_PASSWORD.
MYSQL_OWNER_USER=vet_owner
MYSQL_OWNER_PASSWORD=cambia_esta_clave_owner

# --- Backend FastAPI ---
SECRET_KEY=cambia_esta_clave_secreta_larga
ADMIN_CREATE_KEY=CAMBIA-ESTA-CLAVE
# Orígenes permitidos para CORS (separados por coma). En producción debe ser
# el dominio del frontend, p. ej. https://ejemplo.com
CORS_ORIGINS=https://ejemplo.com

# --- Correo transaccional (SMTP de Gmail) ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=tu_correo@gmail.com
EMAIL_PASSWORD=tu_app_password_de_gmail
