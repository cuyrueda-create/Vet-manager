      "adaptiveIcon": {
        "backgroundColor": "#0066b3",
        "foregroundImage": "./assets/icon.png"
      }
    },
    "extra": {
      "apiUrl": "http://10.0.2.2:5000"
    },
    "plugins": [
      "expo-asset"
    ]
  }
}
